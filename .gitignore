node_modules
dist

# The Jetro VS Code extension used to write agent config into every folder it
# opened, overwriting whatever was there. It was uninstalled on 2026-09-13 and
# these are OURS now, and tracked: CLAUDE.md (imports AGENTS.md, which Claude
# Code never reads on its own), and XUI's MCP server in .mcp.json (Claude
# Code), .cursor/mcp.json (Cursor) and .codex/config.toml (Codex).
#
# Jetro's other file names stay ignored, so a machine that still has it cannot
# commit them by accident. AGENT.md is Jetro's; AGENTS.md (plural) is ours.
.windsurfrules
AGENT.md
.cursor/rules/agent.mdc
.agents/rules/
.github/copilot-instructions.md

# Vercel
.vercel

# local tooling - CONTAINS CREDENTIALS. This was staged by a `git add -A` and
# caught before the commit; the xui repo ignores it for the same reason.
.jetro/

# Private demos. A folder whose name starts with _ is yours alone: it shows in
# your local Playground, `npm run share` never sees it because git never sees it,
# and it never reaches the deployed site. Rename it without the underscore when
# you want the team to have it.
src/demos/*/_*/
